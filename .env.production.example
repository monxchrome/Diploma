# Copy to an ignored .env.production on the Linux VM. Do not place production secret values here.
APP_DOMAIN=decision.example.com
APP_BASE_URL=https://decision.example.com
API_BASE_URL=https://decision.example.com
COOKIE_DOMAIN=decision.example.com
CORS_ALLOWED_ORIGINS=https://decision.example.com
COOKIE_SAME_SITE=lax
CSRF_ENABLED=true

POSTGRES_DB=dip
POSTGRES_USER=dip_user
POSTGRES_PASSWORD=replace-through-host-secret-injection
MINIO_ROOT_USER=replace-through-host-secret-injection
MINIO_ROOT_PASSWORD=replace-through-host-secret-injection
MINIO_BUCKET=dip-documents

BILLING_ENABLED=true
BILLING_PROVIDER=fake
BILLING_PLAN_CATALOG_VERSION=phase-7-v1
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=
STRIPE_SUCCESS_URL=https://decision.example.com/settings/billing
STRIPE_CANCEL_URL=https://decision.example.com/settings/billing
STRIPE_PORTAL_RETURN_URL=https://decision.example.com/settings/billing

EXTERNAL_RESEARCH_ENABLED=false
RESEARCH_PROVIDER=fake
DOCUMENT_MAX_UPLOAD_BYTES=25000000
RATE_LIMIT_POLICY_VERSION=phase-7-v1
DEPLOYMENT_VERSION=replace-at-release
DEPLOYMENT_COMMIT_SHA=replace-at-release
BACKUP_DIRECTORY=/var/backups/dip
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_ENABLED=true
