NODE_ENV=development
LOG_LEVEL=info

WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
AI_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dip
POSTGRES_USER=dip_user
POSTGRES_PASSWORD=dip_password
DATABASE_URL=postgresql://dip_user:dip_password@localhost:5432/dip?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
BULLMQ_CONNECTION_URL=redis://localhost:6379/1

# Phase 5 decision analysis
ANALYSIS_QUEUE_NAME=analysis
ANALYSIS_QUEUE_CONCURRENCY=2
ANALYSIS_JOB_ATTEMPTS=3
ANALYSIS_JOB_TIMEOUT_MS=660000
ANALYSIS_MAX_CONCURRENT_PER_USER=1
ANALYSIS_MAX_CONCURRENT_PER_PROJECT=2
ANALYSIS_RATE_LIMIT=10
ANALYSIS_MAX_DURATION_SECONDS=600
ANALYSIS_MAX_SPECIALISTS=5
ANALYSIS_MAX_RETRIEVAL_QUERIES=5
ANALYSIS_MAX_EVIDENCE_PER_SPECIALIST=8
ANALYSIS_MAX_TOTAL_CONTEXT_TOKENS=12000
ANALYSIS_MAX_TOTAL_OUTPUT_TOKENS=8000
ANALYSIS_MAX_REVISIONS=1
ANALYSIS_GRAPH_VERSION=phase-5-v2
ANALYSIS_CHECKPOINTER_ENABLED=true
ANALYSIS_CHECKPOINT_RETENTION_DAYS=30
AGENT_PLANNER_PROVIDER=ollama
AGENT_PLANNER_MODEL=llama3.2:3b
AGENT_PLANNER_TEMPERATURE=0
AGENT_PLANNER_MAX_TOKENS=1000
AGENT_SPECIALIST_PROVIDER=ollama
AGENT_SPECIALIST_MODEL=llama3.2:3b
AGENT_SPECIALIST_TEMPERATURE=0
AGENT_SPECIALIST_MAX_TOKENS=1600
AGENT_COORDINATOR_PROVIDER=ollama
AGENT_COORDINATOR_MODEL=llama3.2:3b
AGENT_COORDINATOR_TEMPERATURE=0
AGENT_COORDINATOR_MAX_TOKENS=4000
AGENT_CRITIC_PROVIDER=ollama
AGENT_CRITIC_MODEL=llama3.2:3b
AGENT_CRITIC_TEMPERATURE=0
AGENT_CRITIC_MAX_TOKENS=1000
AGENT_MODEL_TIMEOUT_SECONDS=300
ANALYSIS_MIN_QUALITY_SCORE=0.7
ANALYSIS_MIN_GROUNDING_SCORE=0.7
ANALYSIS_ALLOW_DEGRADED_REPORT=true
ANALYSIS_REQUIRED_SPECIALISTS_POLICY=allow-requested

QDRANT_URL=http://localhost:6333
QDRANT_PORT=6333
RETRIEVAL_CANDIDATE_LIMIT=40
RETRIEVAL_TIMEOUT_SECONDS=20
DENSE_WEIGHT=1
SPARSE_WEIGHT=1

MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_URL=http://localhost:9001
MINIO_ROOT_USER=dip_minio
MINIO_ROOT_PASSWORD=dip_minio_password
MINIO_BUCKET=dip-local
MINIO_ACCESS_KEY=dip_minio
MINIO_SECRET_KEY=dip_minio_password
MINIO_PRESIGN_TTL_SECONDS=300
DOCUMENT_MAX_UPLOAD_BYTES=25000000
DOCUMENT_ALLOWED_EXTENSIONS=pdf,docx,txt,md,markdown,html,htm
INGESTION_INTERNAL_SECRET=replace-with-local-development-ingestion-secret-32
INGESTION_TIMEOUT_MS=120000

OLLAMA_URL=http://localhost:11434
OLLAMA_PORT=11434

LANGFUSE_URL=http://localhost:3002
LANGFUSE_PORT=3002
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=replace-with-dev-public-key
LANGFUSE_SECRET_KEY=replace-with-dev-secret-key
LANGFUSE_SALT=replace-with-dev-salt-at-least-32-chars
LANGFUSE_ENCRYPTION_KEY=replace-with-64-char-hex-dev-encryption-key-000000
LANGFUSE_NEXTAUTH_SECRET=replace-with-dev-nextauth-secret
LANGFUSE_POSTGRES_DB=langfuse
LANGFUSE_POSTGRES_USER=langfuse
LANGFUSE_POSTGRES_PASSWORD=langfuse_password
LANGFUSE_CLICKHOUSE_PASSWORD=clickhouse_password

BODY_LIMIT=1mb
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=120

JWT_ACCESS_SECRET=replace-with-local-development-access-secret-32
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=30d
REFRESH_TOKEN_PEPPER=replace-with-local-development-refresh-pepper-32
AUTH_COOKIE_NAME=dip_refresh
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
PASSWORD_MIN_LENGTH=8
AUTH_REGISTER_RATE_LIMIT_LIMIT=5
AUTH_REGISTER_RATE_LIMIT_TTL_SECONDS=300
AUTH_LOGIN_RATE_LIMIT_LIMIT=10
AUTH_LOGIN_RATE_LIMIT_TTL_SECONDS=60
AUTH_REFRESH_RATE_LIMIT_LIMIT=30
AUTH_REFRESH_RATE_LIMIT_TTL_SECONDS=60

# Retrieval and grounded generation
RETRIEVAL_SCORE_THRESHOLD=0.015
RERANK_SCORE_THRESHOLD=0.04
MIN_RELEVANT_EVIDENCE_COUNT=1
RERANKER_ENABLED=true
RERANKER_MODEL=lexical-v1
RAG_ENABLED=true
RAG_PROVIDER=ollama
RAG_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_RAG_MODEL=llama3.2:3b
