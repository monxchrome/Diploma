NODE_ENV=development
LOG_LEVEL=info

# Phase 7 production-readiness defaults. Production uses .env.production.example and Docker secrets.
APP_ENV=development
APP_VERSION=dev
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
TRUSTED_PROXY_COUNT=0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CSRF_ENABLED=false
APP_WORKER_ONLY=false
DEPLOYMENT_ENVIRONMENT=local
DEPLOYMENT_VERSION=dev
DEPLOYMENT_COMMIT_SHA=local

WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
AI_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dip
POSTGRES_USER=dip_user
POSTGRES_PASSWORD=dip_password
DATABASE_URL=postgresql://dip_user:dip_password@localhost:5432/dip?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
BULLMQ_CONNECTION_URL=redis://localhost:6379/1

# Phase 5 decision analysis
ANALYSIS_QUEUE_NAME=analysis
ANALYSIS_QUEUE_CONCURRENCY=2
ANALYSIS_JOB_ATTEMPTS=3
ANALYSIS_JOB_TIMEOUT_MS=660000
ANALYSIS_MAX_CONCURRENT_PER_USER=1
ANALYSIS_MAX_CONCURRENT_PER_PROJECT=2
ANALYSIS_RATE_LIMIT=10
ANALYSIS_MAX_DURATION_SECONDS=600
ANALYSIS_MAX_SPECIALISTS=5
ANALYSIS_MAX_RETRIEVAL_QUERIES=5
ANALYSIS_MAX_EVIDENCE_PER_SPECIALIST=8
ANALYSIS_MAX_TOTAL_CONTEXT_TOKENS=12000
ANALYSIS_MAX_TOTAL_OUTPUT_TOKENS=8000
ANALYSIS_MAX_REVISIONS=1
ANALYSIS_GRAPH_VERSION=phase-6-v1
ANALYSIS_CHECKPOINTER_ENABLED=true
ANALYSIS_CHECKPOINT_RETENTION_DAYS=30
AGENT_PLANNER_PROVIDER=ollama
AGENT_PLANNER_MODEL=llama3.2:3b
AGENT_PLANNER_TEMPERATURE=0
AGENT_PLANNER_MAX_TOKENS=1000
AGENT_SPECIALIST_PROVIDER=ollama
AGENT_SPECIALIST_MODEL=llama3.2:3b
AGENT_SPECIALIST_TEMPERATURE=0
AGENT_SPECIALIST_MAX_TOKENS=1600
AGENT_COORDINATOR_PROVIDER=ollama
AGENT_COORDINATOR_MODEL=llama3.2:3b
AGENT_COORDINATOR_TEMPERATURE=0
AGENT_COORDINATOR_MAX_TOKENS=4000
AGENT_CRITIC_PROVIDER=ollama
AGENT_CRITIC_MODEL=llama3.2:3b
AGENT_CRITIC_TEMPERATURE=0
AGENT_CRITIC_MAX_TOKENS=1000
AGENT_MODEL_TIMEOUT_SECONDS=300
ANALYSIS_MIN_QUALITY_SCORE=0.7
ANALYSIS_MIN_GROUNDING_SCORE=0.7
ANALYSIS_ALLOW_DEGRADED_REPORT=true
ANALYSIS_REQUIRED_SPECIALISTS_POLICY=allow-requested

# Phase 6 controlled external research
EXTERNAL_RESEARCH_ENABLED=false
EXTERNAL_RESEARCH_DEFAULT_MODE=INTERNAL_ONLY
RESEARCH_PROVIDER=fake
RESEARCH_API_KEY=
RESEARCH_MAX_QUERIES=3
RESEARCH_RESULTS_PER_QUERY=5
RESEARCH_MAX_FETCHED_PAGES=5
RESEARCH_MAX_PAGE_BYTES=500000
RESEARCH_MAX_TOTAL_BYTES=2000000
RESEARCH_MAX_REDIRECTS=3
RESEARCH_FETCH_TIMEOUT_SECONDS=10
RESEARCH_TOTAL_TIMEOUT_SECONDS=60
RESEARCH_MAX_CONTEXT_TOKENS=4000
RESEARCH_CACHE_TTL_SECONDS=86400
RESEARCH_POLICY_VERSION=phase-6-v1
RESEARCH_ALLOWED_SCHEMES=http,https
RESEARCH_ALLOWED_CONTENT_TYPES=text/html,text/plain,application/xhtml+xml
RESEARCH_BLOCK_PRIVATE_NETWORKS=true
RESEARCH_DOMAIN_ALLOWLIST=
RESEARCH_DOMAIN_DENYLIST=
RESEARCH_QUEUE_NAME=external-research
RESEARCH_QUEUE_CONCURRENCY=2
RESEARCH_JOB_ATTEMPTS=3
RESEARCH_JOB_TIMEOUT_MS=120000

# Phase 6 scientific evaluation
EXPERIMENT_QUEUE_NAME=experiments
EXPERIMENT_QUEUE_CONCURRENCY=1
EXPERIMENT_MAX_VARIANTS=4
EXPERIMENT_MAX_CASES=10
EXPERIMENT_MAX_REPETITIONS=3
EXPERIMENT_MAX_RUNS=100
EXPERIMENT_JOB_TIMEOUT_MS=600000
EXPERIMENT_MAX_ESTIMATED_COST=25
EVALUATION_RUBRIC_VERSION=phase-6-v1
EVALUATION_LLM_JUDGE_ENABLED=false
EVALUATION_LLM_JUDGE_PROVIDER=disabled
EVALUATION_LLM_JUDGE_MODEL=disabled

QDRANT_URL=http://localhost:6333
QDRANT_PORT=6333
RETRIEVAL_CANDIDATE_LIMIT=40
RETRIEVAL_TIMEOUT_SECONDS=20
DENSE_WEIGHT=1
SPARSE_WEIGHT=1

MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_URL=http://localhost:9001
MINIO_ROOT_USER=dip_minio
MINIO_ROOT_PASSWORD=dip_minio_password
MINIO_BUCKET=dip-local
MINIO_ACCESS_KEY=dip_minio
MINIO_SECRET_KEY=dip_minio_password
MINIO_PRESIGN_TTL_SECONDS=300
DOCUMENT_MAX_UPLOAD_BYTES=25000000
DOCUMENT_ALLOWED_EXTENSIONS=pdf,docx,txt,md,markdown,html,htm
INGESTION_INTERNAL_SECRET=replace-with-local-development-ingestion-secret-32
INGESTION_TIMEOUT_MS=120000

OLLAMA_URL=http://localhost:11434
OLLAMA_PORT=11434
OLLAMA_GPU_DEVICES=all

LANGFUSE_URL=http://localhost:3002
LANGFUSE_PORT=3002
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=replace-with-dev-public-key
LANGFUSE_SECRET_KEY=replace-with-dev-secret-key
LANGFUSE_SALT=replace-with-dev-salt-at-least-32-chars
LANGFUSE_ENCRYPTION_KEY=replace-with-64-char-hex-dev-encryption-key-000000
LANGFUSE_NEXTAUTH_SECRET=replace-with-dev-nextauth-secret
LANGFUSE_POSTGRES_DB=langfuse
LANGFUSE_POSTGRES_USER=langfuse
LANGFUSE_POSTGRES_PASSWORD=langfuse_password
LANGFUSE_CLICKHOUSE_PASSWORD=clickhouse_password

BODY_LIMIT=1mb
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=120
RATE_LIMIT_ENABLED=true
RATE_LIMIT_POLICY_VERSION=phase-7-v1
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_READ_PER_MINUTE=120
RATE_LIMIT_API_WRITE_PER_MINUTE=60
RATE_LIMIT_ANALYSIS_PER_HOUR=10
RATE_LIMIT_RESEARCH_PER_HOUR=20
RATE_LIMIT_EXPERIMENT_PER_HOUR=10
RATE_LIMIT_EXPORT_PER_HOUR=30
RATE_LIMIT_UPLOAD_PER_HOUR=30
RATE_LIMIT_WEBHOOK_PER_MINUTE=120

# Phase 8 billing, usage, and quota enforcement. Fake billing is deterministic and local-only.
BILLING_ENABLED=true
BILLING_PROVIDER=fake
BILLING_ALLOW_FAKE_IN_PRODUCTION_UNSAFE=false
BILLING_PLAN_CATALOG_VERSION=phase-8-v1
BILLING_CURRENCY=USD
BILLING_FAKE_PROVIDER_ENABLED=true
BILLING_FAKE_WEBHOOK_SECRET=replace-with-local-development-fake-billing-secret-32
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:3000/settings/billing
STRIPE_CANCEL_URL=http://localhost:3000/settings/billing
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/settings/billing
USAGE_METERING_ENABLED=true
USAGE_BILLING_PERIOD_TIMEZONE=UTC
USAGE_RESERVATION_TTL_SECONDS=900
USAGE_AGGREGATION_INTERVAL_SECONDS=300
BACKUP_ENABLED=false
BACKUP_DIRECTORY=/var/backups/dip
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_ENABLED=false

JWT_ACCESS_SECRET=replace-with-local-development-access-secret-32
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=30d
REFRESH_TOKEN_PEPPER=replace-with-local-development-refresh-pepper-32
AUTH_COOKIE_NAME=dip_refresh
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
PASSWORD_MIN_LENGTH=8
AUTH_REGISTER_RATE_LIMIT_LIMIT=5
AUTH_REGISTER_RATE_LIMIT_TTL_SECONDS=300
AUTH_LOGIN_RATE_LIMIT_LIMIT=10
AUTH_LOGIN_RATE_LIMIT_TTL_SECONDS=60
AUTH_REFRESH_RATE_LIMIT_LIMIT=30
AUTH_REFRESH_RATE_LIMIT_TTL_SECONDS=60

# Retrieval and grounded generation
RETRIEVAL_SCORE_THRESHOLD=0.015
RERANK_SCORE_THRESHOLD=0.04
MIN_RELEVANT_EVIDENCE_COUNT=1
RERANKER_ENABLED=true
RERANKER_MODEL=lexical-v1
RAG_ENABLED=true
RAG_PROVIDER=ollama
RAG_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_RAG_MODEL=llama3.2:3b
