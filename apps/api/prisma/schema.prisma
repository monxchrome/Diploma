generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GlobalRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProjectMemberRole {
  OWNER
  EDITOR
  VIEWER
}

enum KnowledgeBaseStatus {
  ACTIVE
  ARCHIVED
}

enum DocumentStatus {
  PENDING_UPLOAD
  UPLOADED
  QUEUED
  VALIDATING
  PARSING
  CHUNKING
  EMBEDDING
  INDEXING
  COMPLETED
  FAILED
  ARCHIVED
}

enum IngestionJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum RetrievalMode {
  DENSE
  SPARSE
  HYBRID
}

enum RetrievalRunStatus {
  COMPLETED
  FAILED
}

enum AnalysisMode {
  SINGLE_AGENT
  MULTI_AGENT
}

enum AnalysisStatus {
  DRAFT
  QUEUED
  RUNNING
  COMPLETED
  COMPLETED_WITH_LIMITATIONS
  FAILED
  CANCELLED
  ARCHIVED
}

enum AgentRunStatus {
  PENDING
  RUNNING
  COMPLETED
  DEGRADED
  FAILED
  SKIPPED
}

enum SpecialistType {
  MARKET
  FINANCIAL
  LEGAL_REGULATORY
  RISK
  STRATEGY
}

model SystemCheck {
  id        String   @id @default(uuid())
  service   String
  status    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([service, createdAt])
}

model User {
  id              String          @id @default(uuid()) @db.Uuid
  email           String          @unique
  passwordHash    String
  displayName     String
  globalRole      GlobalRole      @default(USER)
  status          UserStatus      @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  sessions        AuthSession[]
  ownedProjects   Project[]       @relation("ProjectOwner")
  memberships     ProjectMember[]
  auditLogs       AuditLog[]      @relation("AuditLogActor")
  knowledgeBases  KnowledgeBase[] @relation("KnowledgeBaseCreator")
  documents       Document[]      @relation("DocumentCreator")
  retrievalRuns   RetrievalRun[]
  answerFeedback  AnswerFeedback[]
  analyses        DecisionAnalysis[]
  analysisRuns    AnalysisRun[]
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique
  familyId         String    @db.Uuid
  userAgent        String?
  ipHash           String?
  expiresAt        DateTime
  lastUsedAt       DateTime
  revokedAt        DateTime?
  revokeReason     String?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([familyId, revokedAt])
}

model Project {
  id          String          @id @default(uuid()) @db.Uuid
  ownerId     String          @db.Uuid
  name        String
  description String?
  settings    Json            @default("{}")
  archivedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  owner       User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members     ProjectMember[]
  auditLogs   AuditLog[]
  knowledgeBases KnowledgeBase[]
  retrievalRuns RetrievalRun[]
  analyses      DecisionAnalysis[]
  analysisRuns  AnalysisRun[]

  @@index([ownerId])
  @@index([archivedAt])
  @@index([createdAt])
}

model KnowledgeBase {
  id          String              @id @default(uuid()) @db.Uuid
  projectId   String              @db.Uuid
  name        String
  description String?
  status      KnowledgeBaseStatus @default(ACTIVE)
  createdById String              @db.Uuid
  archivedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User                @relation("KnowledgeBaseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  documents   Document[]

  @@index([projectId, status, createdAt])
  @@index([projectId, archivedAt])
}

model Document {
  id              String         @id @default(uuid()) @db.Uuid
  knowledgeBaseId String         @db.Uuid
  originalFilename String
  displayName     String
  status          DocumentStatus @default(PENDING_UPLOAD)
  mimeType        String?
  declaredMimeType String
  sizeBytes       BigInt
  currentVersionId String?       @unique @db.Uuid
  createdById     String         @db.Uuid
  archivedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  knowledgeBase   KnowledgeBase  @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  createdBy       User           @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  versions        DocumentVersion[]
  currentVersion  DocumentVersion? @relation("CurrentDocumentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  @@index([knowledgeBaseId, status, createdAt])
  @@index([knowledgeBaseId, archivedAt])
}

model DocumentVersion {
  id                 String         @id @default(uuid()) @db.Uuid
  documentId         String         @db.Uuid
  version            Int
  storageKey         String         @unique
  checksumSha256     String?
  detectedMimeType   String?
  parserName         String?
  parserVersion      String?
  chunkerVersion     String?
  embeddingProvider  String?
  embeddingModel     String?
  embeddingDimension Int?
  pageCount          Int?
  characterCount     Int?
  tokenCount         Int?
  status             DocumentStatus @default(PENDING_UPLOAD)
  errorCode          String?
  errorMessage       String?
  createdAt          DateTime       @default(now())
  completedAt        DateTime?
  document           Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  activeForDocument  Document?      @relation("CurrentDocumentVersion")
  chunks             DocumentChunk[]
  ingestionJobs      IngestionJob[]

  @@unique([documentId, version])
  @@index([checksumSha256])
  @@index([documentId, status, createdAt])
}

model DocumentChunk {
  id                String          @id @default(uuid()) @db.Uuid
  documentVersionId String          @db.Uuid
  chunkIndex        Int
  content           String
  tokenCount        Int
  pageStart         Int?
  pageEnd           Int?
  headingPath       Json            @default("[]")
  metadata          Json            @default("{}")
  vectorPointId     String          @unique
  contentHash       String
  createdAt         DateTime        @default(now())
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@unique([documentVersionId, chunkIndex])
  @@index([documentVersionId])
}

model RetrievalRun {
  id              String             @id @default(uuid()) @db.Uuid
  projectId       String             @db.Uuid
  userId          String             @db.Uuid
  query           String
  normalizedQuery String
  mode            RetrievalMode
  filters         Json               @default("{}")
  status          RetrievalRunStatus @default(COMPLETED)
  timingsMs       Json               @default("{}")
  resultCount     Int                @default(0)
  createdAt       DateTime           @default(now())
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  response        RagResponse?
  analysisRuns    AnalysisRun[]

  @@index([projectId, userId, createdAt])
  @@index([projectId, createdAt])
}

model RagResponse {
  id                   String          @id @default(uuid()) @db.Uuid
  retrievalRunId       String          @unique @db.Uuid
  answer               String
  insufficientEvidence Boolean         @default(false)
  createdAt            DateTime        @default(now())
  retrievalRun         RetrievalRun    @relation(fields: [retrievalRunId], references: [id], onDelete: Cascade)
  citations            RagCitation[]
  feedback             AnswerFeedback[]
}

model RagCitation {
  id            String      @id @default(uuid()) @db.Uuid
  ragResponseId String      @db.Uuid
  evidenceId    String
  documentId    String      @db.Uuid
  chunkId       String      @db.Uuid
  quote         String
  createdAt     DateTime    @default(now())
  ragResponse   RagResponse @relation(fields: [ragResponseId], references: [id], onDelete: Cascade)

  @@index([ragResponseId])
  @@index([documentId])
}

model AnswerFeedback {
  id            String      @id @default(uuid()) @db.Uuid
  ragResponseId String      @db.Uuid
  userId        String      @db.Uuid
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())
  ragResponse   RagResponse @relation(fields: [ragResponseId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ragResponseId, userId])
  @@index([userId, createdAt])
}

model IngestionJob {
  id                String             @id @default(uuid()) @db.Uuid
  documentVersionId String             @db.Uuid
  bullJobId         String?
  status            IngestionJobStatus @default(QUEUED)
  attempt           Int                @default(0)
  progress          Int                @default(0)
  currentStage      String?
  queuedAt          DateTime           @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  errorCode         String?
  errorMessage      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  documentVersion   DocumentVersion    @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@index([documentVersionId, status, createdAt])
  @@index([status, queuedAt])
}

model DecisionAnalysis {
  id                   String       @id @default(uuid()) @db.Uuid
  projectId            String       @db.Uuid
  createdById          String       @db.Uuid
  title                String
  decisionQuestion     String
  objectives           Json         @default("[]")
  constraints          Json         @default("[]")
  assumptions          Json         @default("[]")
  timeHorizon          String?
  targetMarket         String?
  currency             String?
  knowledgeBaseIds     Json
  documentIds          Json         @default("[]")
  mode                 AnalysisMode
  requestedSpecialists Json         @default("[]")
  additionalContext    String?
  archivedAt           DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  project              Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy            User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  runs                 AnalysisRun[]

  @@index([projectId, archivedAt, createdAt])
  @@index([createdById, createdAt])
}

model AnalysisRun {
  id                   String         @id @default(uuid()) @db.Uuid
  analysisId           String         @db.Uuid
  projectId            String         @db.Uuid
  userId               String         @db.Uuid
  status               AnalysisStatus @default(DRAFT)
  threadId             String         @unique
  graphVersion         String
  promptVersions       Json           @default("{}")
  bullJobId            String?        @unique
  cancellationRequested Boolean       @default(false)
  currentStage         String?
  progress             Int            @default(0)
  plan                 Json?
  initialRetrievalRunId String?       @db.Uuid
  tokenUsage           Json           @default("{}")
  estimatedCost        Decimal?       @db.Decimal(12, 6)
  timingsMs            Json           @default("{}")
  errorCode            String?
  errorMessage         String?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  analysis             DecisionAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  project              Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                 User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  retrievalRun         RetrievalRun?  @relation(fields: [initialRetrievalRunId], references: [id], onDelete: SetNull)
  agentRuns            AgentRun[]
  report               AnalysisReport?
  checkpoints          AnalysisCheckpoint[]

  @@index([analysisId, createdAt])
  @@index([projectId, status, createdAt])
  @@index([userId, status, createdAt])
}

model AgentRun {
  id            String         @id @default(uuid()) @db.Uuid
  analysisRunId String         @db.Uuid
  specialist    SpecialistType?
  nodeName      String
  status        AgentRunStatus @default(PENDING)
  result        Json?
  tokenUsage    Json           @default("{}")
  timingsMs     Json           @default("{}")
  errorCode     String?
  errorMessage  String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  analysisRun   AnalysisRun    @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)

  @@unique([analysisRunId, nodeName])
  @@index([analysisRunId, status])
}

model AnalysisReport {
  id            String      @id @default(uuid()) @db.Uuid
  analysisRunId String      @unique @db.Uuid
  report        Json
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  analysisRun   AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  citations     AnalysisCitation[]
}

model AnalysisCitation {
  id               String         @id @default(uuid()) @db.Uuid
  analysisReportId String         @db.Uuid
  evidenceId       String
  documentId       String         @db.Uuid
  chunkId          String         @db.Uuid
  quote            String
  createdAt        DateTime       @default(now())
  analysisReport   AnalysisReport @relation(fields: [analysisReportId], references: [id], onDelete: Cascade)

  @@unique([analysisReportId, evidenceId, chunkId])
  @@index([documentId])
}

model AnalysisCheckpoint {
  id            String      @id @default(uuid()) @db.Uuid
  analysisRunId String      @db.Uuid
  graphVersion  String
  nodeName      String
  state         Json
  createdAt     DateTime    @default(now())
  analysisRun   AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)

  @@unique([analysisRunId, nodeName])
  @@index([createdAt])
}

model ProjectMember {
  projectId String            @db.Uuid
  userId    String            @db.Uuid
  role      ProjectMemberRole
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@index([role])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?  @db.Uuid
  projectId   String?  @db.Uuid
  requestId   String
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([projectId, createdAt])
  @@index([action, createdAt])
  @@index([requestId])
}
