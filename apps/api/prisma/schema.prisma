generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GlobalRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProjectMemberRole {
  OWNER
  EDITOR
  VIEWER
}

enum KnowledgeBaseStatus {
  ACTIVE
  ARCHIVED
}

enum DocumentStatus {
  PENDING_UPLOAD
  UPLOADED
  QUEUED
  VALIDATING
  PARSING
  CHUNKING
  EMBEDDING
  INDEXING
  COMPLETED
  FAILED
  ARCHIVED
}

enum IngestionJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum RetrievalMode {
  DENSE
  SPARSE
  HYBRID
}

enum RetrievalRunStatus {
  COMPLETED
  FAILED
}

model SystemCheck {
  id        String   @id @default(uuid())
  service   String
  status    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([service, createdAt])
}

model User {
  id              String          @id @default(uuid()) @db.Uuid
  email           String          @unique
  passwordHash    String
  displayName     String
  globalRole      GlobalRole      @default(USER)
  status          UserStatus      @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  sessions        AuthSession[]
  ownedProjects   Project[]       @relation("ProjectOwner")
  memberships     ProjectMember[]
  auditLogs       AuditLog[]      @relation("AuditLogActor")
  knowledgeBases  KnowledgeBase[] @relation("KnowledgeBaseCreator")
  documents       Document[]      @relation("DocumentCreator")
  retrievalRuns   RetrievalRun[]
  answerFeedback  AnswerFeedback[]
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique
  familyId         String    @db.Uuid
  userAgent        String?
  ipHash           String?
  expiresAt        DateTime
  lastUsedAt       DateTime
  revokedAt        DateTime?
  revokeReason     String?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([familyId, revokedAt])
}

model Project {
  id          String          @id @default(uuid()) @db.Uuid
  ownerId     String          @db.Uuid
  name        String
  description String?
  settings    Json            @default("{}")
  archivedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  owner       User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members     ProjectMember[]
  auditLogs   AuditLog[]
  knowledgeBases KnowledgeBase[]
  retrievalRuns RetrievalRun[]

  @@index([ownerId])
  @@index([archivedAt])
  @@index([createdAt])
}

model KnowledgeBase {
  id          String              @id @default(uuid()) @db.Uuid
  projectId   String              @db.Uuid
  name        String
  description String?
  status      KnowledgeBaseStatus @default(ACTIVE)
  createdById String              @db.Uuid
  archivedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User                @relation("KnowledgeBaseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  documents   Document[]

  @@index([projectId, status, createdAt])
  @@index([projectId, archivedAt])
}

model Document {
  id              String         @id @default(uuid()) @db.Uuid
  knowledgeBaseId String         @db.Uuid
  originalFilename String
  displayName     String
  status          DocumentStatus @default(PENDING_UPLOAD)
  mimeType        String?
  declaredMimeType String
  sizeBytes       BigInt
  currentVersionId String?       @unique @db.Uuid
  createdById     String         @db.Uuid
  archivedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  knowledgeBase   KnowledgeBase  @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  createdBy       User           @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  versions        DocumentVersion[]
  currentVersion  DocumentVersion? @relation("CurrentDocumentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  @@index([knowledgeBaseId, status, createdAt])
  @@index([knowledgeBaseId, archivedAt])
}

model DocumentVersion {
  id                 String         @id @default(uuid()) @db.Uuid
  documentId         String         @db.Uuid
  version            Int
  storageKey         String         @unique
  checksumSha256     String?
  detectedMimeType   String?
  parserName         String?
  parserVersion      String?
  chunkerVersion     String?
  embeddingProvider  String?
  embeddingModel     String?
  embeddingDimension Int?
  pageCount          Int?
  characterCount     Int?
  tokenCount         Int?
  status             DocumentStatus @default(PENDING_UPLOAD)
  errorCode          String?
  errorMessage       String?
  createdAt          DateTime       @default(now())
  completedAt        DateTime?
  document           Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  activeForDocument  Document?      @relation("CurrentDocumentVersion")
  chunks             DocumentChunk[]
  ingestionJobs      IngestionJob[]

  @@unique([documentId, version])
  @@index([checksumSha256])
  @@index([documentId, status, createdAt])
}

model DocumentChunk {
  id                String          @id @default(uuid()) @db.Uuid
  documentVersionId String          @db.Uuid
  chunkIndex        Int
  content           String
  tokenCount        Int
  pageStart         Int?
  pageEnd           Int?
  headingPath       Json            @default("[]")
  metadata          Json            @default("{}")
  vectorPointId     String          @unique
  contentHash       String
  createdAt         DateTime        @default(now())
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@unique([documentVersionId, chunkIndex])
  @@index([documentVersionId])
}

model RetrievalRun {
  id              String             @id @default(uuid()) @db.Uuid
  projectId       String             @db.Uuid
  userId          String             @db.Uuid
  query           String
  normalizedQuery String
  mode            RetrievalMode
  filters         Json               @default("{}")
  status          RetrievalRunStatus @default(COMPLETED)
  timingsMs       Json               @default("{}")
  resultCount     Int                @default(0)
  createdAt       DateTime           @default(now())
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  response        RagResponse?

  @@index([projectId, userId, createdAt])
  @@index([projectId, createdAt])
}

model RagResponse {
  id                   String          @id @default(uuid()) @db.Uuid
  retrievalRunId       String          @unique @db.Uuid
  answer               String
  insufficientEvidence Boolean         @default(false)
  createdAt            DateTime        @default(now())
  retrievalRun         RetrievalRun    @relation(fields: [retrievalRunId], references: [id], onDelete: Cascade)
  citations            RagCitation[]
  feedback             AnswerFeedback[]
}

model RagCitation {
  id            String      @id @default(uuid()) @db.Uuid
  ragResponseId String      @db.Uuid
  evidenceId    String
  documentId    String      @db.Uuid
  chunkId       String      @db.Uuid
  quote         String
  createdAt     DateTime    @default(now())
  ragResponse   RagResponse @relation(fields: [ragResponseId], references: [id], onDelete: Cascade)

  @@index([ragResponseId])
  @@index([documentId])
}

model AnswerFeedback {
  id            String      @id @default(uuid()) @db.Uuid
  ragResponseId String      @db.Uuid
  userId        String      @db.Uuid
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())
  ragResponse   RagResponse @relation(fields: [ragResponseId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ragResponseId, userId])
  @@index([userId, createdAt])
}

model IngestionJob {
  id                String             @id @default(uuid()) @db.Uuid
  documentVersionId String             @db.Uuid
  bullJobId         String?
  status            IngestionJobStatus @default(QUEUED)
  attempt           Int                @default(0)
  progress          Int                @default(0)
  currentStage      String?
  queuedAt          DateTime           @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  errorCode         String?
  errorMessage      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  documentVersion   DocumentVersion    @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@index([documentVersionId, status, createdAt])
  @@index([status, queuedAt])
}

model ProjectMember {
  projectId String            @db.Uuid
  userId    String            @db.Uuid
  role      ProjectMemberRole
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@index([role])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?  @db.Uuid
  projectId   String?  @db.Uuid
  requestId   String
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([projectId, createdAt])
  @@index([action, createdAt])
  @@index([requestId])
}
