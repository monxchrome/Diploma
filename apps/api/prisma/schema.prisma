generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GlobalRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProjectMemberRole {
  OWNER
  EDITOR
  VIEWER
}

enum KnowledgeBaseStatus {
  ACTIVE
  ARCHIVED
}

enum DocumentStatus {
  PENDING_UPLOAD
  UPLOADED
  QUEUED
  VALIDATING
  PARSING
  CHUNKING
  EMBEDDING
  INDEXING
  COMPLETED
  FAILED
  ARCHIVED
}

enum IngestionJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum RetrievalMode {
  DENSE
  SPARSE
  HYBRID
}

enum RetrievalRunStatus {
  COMPLETED
  FAILED
}

enum AnalysisMode {
  SINGLE_AGENT
  MULTI_AGENT
}

enum EvidenceMode {
  INTERNAL_ONLY
  EXTERNAL_ONLY
  HYBRID
}

enum ResearchRunStatus {
  QUEUED
  PLANNING
  SEARCHING
  FETCHING
  EXTRACTING
  COMPLETED
  COMPLETED_WITH_LIMITATIONS
  FAILED
  CANCELLED
}

enum ResearchQueryStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum ResearchFetchStatus {
  FETCHED
  REJECTED
  FAILED
}

enum EvidenceConflictStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum ExperimentStatus {
  DRAFT
  QUEUED
  RUNNING
  COMPLETED
  COMPLETED_WITH_LIMITATIONS
  FAILED
  CANCELLED
}

enum ExperimentRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  COMPLETED_WITH_LIMITATIONS
  FAILED
  CANCELLED
}

enum AnalysisStatus {
  DRAFT
  QUEUED
  RUNNING
  COMPLETED
  COMPLETED_WITH_LIMITATIONS
  FAILED
  CANCELLED
  ARCHIVED
}

enum AgentRunStatus {
  PENDING
  RUNNING
  COMPLETED
  DEGRADED
  FAILED
  SKIPPED
}

enum SpecialistType {
  MARKET
  FINANCIAL
  LEGAL_REGULATORY
  RISK
  STRATEGY
}

enum PlanCode {
  FREE
  PRO
  TEAM
}

enum BillingProviderName {
  FAKE
  STRIPE
}

enum SubscriptionStatus {
  NONE
  TRIALING
  ACTIVE
  PAST_DUE
  UNPAID
  PAUSED
  CANCELLED
  INCOMPLETE
  EXPIRED
}

enum BillingWebhookEventStatus {
  RECEIVED
  PROCESSED
  REJECTED
  FAILED
}

enum UsageReservationStatus {
  ACTIVE
  FINALIZED
  RELEASED
  EXPIRED
}

enum BillingCheckoutStatus {
  CREATED
  COMPLETED
  EXPIRED
}

enum ReportSnapshotStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ExportFormat {
  PDF
  DOCX
  MARKDOWN
  PRINT_HTML
}

enum ExportJobStatus {
  QUEUED
  GENERATING
  VALIDATING
  UPLOADING
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
}

enum ShareAccessMode {
  PUBLIC_READ_ONLY
  AUTHENTICATED_READ_ONLY
  PROJECT_MEMBERS_ONLY
  AUTHENTICATED_COMMENT
}

enum CommentTargetType {
  REPORT_GENERAL
  REPORT_SECTION
  CITATION
  EVIDENCE_SUMMARY
}

enum CommentThreadStatus {
  OPEN
  RESOLVED
  DELETED
}

enum CollaborationNotificationType {
  MENTIONED_IN_COMMENT
  REPLIED_TO_COMMENT
  THREAD_RESOLVED
  THREAD_REOPENED
  EXPORT_COMPLETED
  EXPORT_FAILED
  SHARE_LINK_CREATED
  SHARE_LINK_REVOKED
}

// Phase 11. `OLLAMA` identifies the configured local runtime, never a model
// family; local Qwen profiles therefore retain `family = QWEN`.
enum ModelProviderCode {
  OPENAI
  ANTHROPIC
  OLLAMA
}

enum ModelRuntime {
  CLOUD
  LOCAL_OLLAMA
}

enum BenchmarkArchitecture {
  SINGLE_AGENT
  HOMOGENEOUS_MULTI_AGENT
  HETEROGENEOUS_MULTI_AGENT
  ABLATION
}

enum BenchmarkProtocol {
  CONTROLLED_EVIDENCE
  END_TO_END
}

enum BenchmarkBudgetProtocol {
  EQUAL_TOTAL_TOKEN_BUDGET
  PRODUCTION_DEFAULT_BUDGET
}

enum BenchmarkSuiteStatus {
  DRAFT
  READY
  RUNNING
  COMPLETED
  ARCHIVED
}

enum BenchmarkRunStatus {
  DRAFT
  QUEUED
  RUNNING
  PAUSED
  EVALUATING
  AGGREGATING
  COMPLETED
  COMPLETED_WITH_LIMITATIONS
  FAILED
  CANCELLED
}

enum BenchmarkCaseRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  COMPLETED_WITH_LIMITATIONS
  FAILED
  CANCELLED
  INVALID
}

enum BenchmarkAgentRole {
  SINGLE_AGENT
  PLANNER
  MARKET_SPECIALIST
  FINANCE_SPECIALIST
  LEGAL_SPECIALIST
  RISK_SPECIALIST
  STRATEGY_SPECIALIST
  COORDINATOR
  CRITIC
}

enum AutomaticEvaluationStatus {
  PENDING
  COMPLETED
  FAILED
}

enum HumanEvaluationTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
  INVALIDATED
}

enum HumanEvaluationPreference {
  LEFT
  RIGHT
  TIE
  CANNOT_EVALUATE
}

enum ReproducibilityArtifactStatus {
  QUEUED
  GENERATING
  COMPLETED
  FAILED
  EXPIRED
}

model SystemCheck {
  id        String   @id @default(uuid())
  service   String
  status    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([service, createdAt])
}

model PlanDefinition {
  id               String   @id @default(uuid()) @db.Uuid
  code             PlanCode
  version          String
  name             String
  displayName      String
  description      String
  billingInterval  String
  displayPrice     String
  currency         String
  providerPriceKey String?
  features         Json
  entitlements     Json
  displayOrder     Int      @default(0)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([code, version])
  @@index([active, code])
}

model BillingCustomer {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @unique @db.Uuid
  provider           BillingProviderName
  providerCustomerId String              @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([provider, providerCustomerId])
}

model Subscription {
  id                     String              @id @default(uuid()) @db.Uuid
  userId                 String              @unique @db.Uuid
  billingCustomerId      String?             @unique @db.Uuid
  planCode               PlanCode            @default(FREE)
  planVersion            String
  provider               BillingProviderName @default(FAKE)
  providerSubscriptionId String?             @unique
  providerPriceId        String?
  status                 SubscriptionStatus  @default(NONE)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean             @default(false)
  trialEndsAt            DateTime?
  cancelledAt            DateTime?
  lastProviderEventAt    DateTime?
  metadata               Json                @default("{}")
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([provider, providerSubscriptionId])
  @@index([status, currentPeriodEnd])
}

model BillingCheckout {
  id                String                @id @default(uuid()) @db.Uuid
  userId            String                @db.Uuid
  provider          BillingProviderName
  providerSessionId String                @unique
  planCode          PlanCode
  planVersion       String
  status            BillingCheckoutStatus @default(CREATED)
  expiresAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([userId, status, createdAt])
  @@index([provider, status])
}

model BillingWebhookEvent {
  id                 String                    @id @default(uuid()) @db.Uuid
  provider           BillingProviderName
  providerEventId    String
  eventType          String
  status             BillingWebhookEventStatus @default(RECEIVED)
  payloadHash        String
  processingAttempts Int                       @default(0)
  processedAt        DateTime?
  failureCode        String?
  failureMessage     String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@unique([provider, providerEventId])
  @@index([status, createdAt])
}

model UsageEvent {
  id                      String   @id @default(uuid()) @db.Uuid
  userId                  String   @db.Uuid
  projectId               String?  @db.Uuid
  subscriptionId          String?  @db.Uuid
  eventType               String
  metric                  String
  resourceType            String
  resourceId              String
  quantity                Decimal  @db.Decimal(18, 6)
  unit                    String
  estimatedCostMinorUnits BigInt?
  currency                String?
  billingPeriod           String
  idempotencyKey          String   @unique
  metadata                Json     @default("{}")
  occurredAt              DateTime
  createdAt               DateTime @default(now())

  @@index([userId, billingPeriod, eventType])
  @@index([projectId, billingPeriod, eventType])
  @@index([resourceType, resourceId])
}

model UsageAggregate {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  projectId     String?  @db.Uuid
  scopeKey      String
  billingPeriod String
  metric        String
  quantity      Decimal  @db.Decimal(18, 6)
  updatedAt     DateTime @updatedAt

  @@unique([userId, scopeKey, billingPeriod, metric])
  @@index([userId, projectId, billingPeriod])
}

model UsageReservation {
  id               String                 @id @default(uuid()) @db.Uuid
  userId           String                 @db.Uuid
  projectId        String?                @db.Uuid
  metric           String
  billingPeriod    String
  reservedQuantity Decimal                @db.Decimal(18, 6)
  status           UsageReservationStatus @default(ACTIVE)
  resourceId       String
  idempotencyKey   String                 @unique
  expiresAt        DateTime
  finalizedAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([userId, projectId, metric, billingPeriod, status, expiresAt])
  @@index([resourceId])
}

model EntitlementOverride {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String?   @db.Uuid
  projectId   String?   @db.Uuid
  entitlement String
  value       Json
  reason      String
  createdById String    @db.Uuid
  startsAt    DateTime
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, entitlement, startsAt, expiresAt])
  @@index([projectId, entitlement, startsAt, expiresAt])
}

model User {
  id                    String                      @id @default(uuid()) @db.Uuid
  email                 String                      @unique
  passwordHash          String
  displayName           String
  globalRole            GlobalRole                  @default(USER)
  status                UserStatus                  @default(ACTIVE)
  emailVerifiedAt       DateTime?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  sessions              AuthSession[]
  ownedProjects         Project[]                   @relation("ProjectOwner")
  memberships           ProjectMember[]
  auditLogs             AuditLog[]                  @relation("AuditLogActor")
  knowledgeBases        KnowledgeBase[]             @relation("KnowledgeBaseCreator")
  documents             Document[]                  @relation("DocumentCreator")
  retrievalRuns         RetrievalRun[]
  answerFeedback        AnswerFeedback[]
  analyses              DecisionAnalysis[]
  analysisRuns          AnalysisRun[]
  experiments           Experiment[]
  experimentEvaluations HumanEvaluation[]
  reportLineages        ReportLineage[]             @relation("ReportLineageCreator")
  reportSnapshots       ReportSnapshot[]            @relation("ReportSnapshotCreator")
  exportJobs            ExportJob[]                 @relation("ExportJobRequester")
  exportArtifacts       ExportArtifact[]            @relation("ExportArtifactOwner")
  shareLinks            ShareLink[]                 @relation("ShareLinkCreator")
  revokedShareLinks     ShareLink[]                 @relation("ShareLinkRevoker")
  commentThreads        CommentThread[]             @relation("CommentThreadCreator")
  comments              Comment[]                   @relation("CommentAuthor")
  deletedComments       Comment[]                   @relation("CommentDeleter")
  mentionsCreated       Mention[]                   @relation("MentionCreator")
  mentionsReceived      Mention[]                   @relation("MentionRecipient")
  notificationsReceived CollaborationNotification[] @relation("NotificationRecipient")
  notificationsActed    CollaborationNotification[] @relation("NotificationActor")
  brandProfiles         BrandProfile[]
  selectedBrandProfiles ProjectBrandProfile[]       @relation("ProjectBrandSelector")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique
  familyId         String    @db.Uuid
  userAgent        String?
  ipHash           String?
  expiresAt        DateTime
  lastUsedAt       DateTime
  revokedAt        DateTime?
  revokeReason     String?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([familyId, revokedAt])
}

model Project {
  id              String               @id @default(uuid()) @db.Uuid
  ownerId         String               @db.Uuid
  name            String
  description     String?
  settings        Json                 @default("{}")
  archivedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  owner           User                 @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members         ProjectMember[]
  auditLogs       AuditLog[]
  knowledgeBases  KnowledgeBase[]
  retrievalRuns   RetrievalRun[]
  analyses        DecisionAnalysis[]
  analysisRuns    AnalysisRun[]
  researchRuns    ResearchRun[]
  experiments     Experiment[]
  reportLineages  ReportLineage[]
  reportSnapshots ReportSnapshot[]
  shareLinks      ShareLink[]
  commentThreads  CommentThread[]
  brandProfile    ProjectBrandProfile?
  benchmarkSuites BenchmarkSuite[]

  @@index([ownerId])
  @@index([archivedAt])
  @@index([createdAt])
}

model KnowledgeBase {
  id          String              @id @default(uuid()) @db.Uuid
  projectId   String              @db.Uuid
  name        String
  description String?
  status      KnowledgeBaseStatus @default(ACTIVE)
  createdById String              @db.Uuid
  archivedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User                @relation("KnowledgeBaseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  documents   Document[]

  @@index([projectId, status, createdAt])
  @@index([projectId, archivedAt])
}

model Document {
  id                 String            @id @default(uuid()) @db.Uuid
  knowledgeBaseId    String            @db.Uuid
  originalFilename   String
  displayName        String
  status             DocumentStatus    @default(PENDING_UPLOAD)
  mimeType           String?
  declaredMimeType   String
  sizeBytes          BigInt
  billingOwnerUserId String            @db.Uuid
  currentVersionId   String?           @unique @db.Uuid
  createdById        String            @db.Uuid
  archivedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  knowledgeBase      KnowledgeBase     @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  createdBy          User              @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  versions           DocumentVersion[]
  currentVersion     DocumentVersion?  @relation("CurrentDocumentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  @@index([knowledgeBaseId, status, createdAt])
  @@index([knowledgeBaseId, archivedAt])
}

model DocumentVersion {
  id                 String          @id @default(uuid()) @db.Uuid
  documentId         String          @db.Uuid
  version            Int
  storageKey         String          @unique
  checksumSha256     String?
  detectedMimeType   String?
  parserName         String?
  parserVersion      String?
  chunkerVersion     String?
  embeddingProvider  String?
  embeddingModel     String?
  embeddingDimension Int?
  pageCount          Int?
  characterCount     Int?
  tokenCount         Int?
  status             DocumentStatus  @default(PENDING_UPLOAD)
  errorCode          String?
  errorMessage       String?
  createdAt          DateTime        @default(now())
  completedAt        DateTime?
  document           Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  activeForDocument  Document?       @relation("CurrentDocumentVersion")
  chunks             DocumentChunk[]
  ingestionJobs      IngestionJob[]

  @@unique([documentId, version])
  @@index([checksumSha256])
  @@index([documentId, status, createdAt])
}

model DocumentChunk {
  id                String          @id @default(uuid()) @db.Uuid
  documentVersionId String          @db.Uuid
  chunkIndex        Int
  content           String
  tokenCount        Int
  pageStart         Int?
  pageEnd           Int?
  headingPath       Json            @default("[]")
  metadata          Json            @default("{}")
  vectorPointId     String          @unique
  contentHash       String
  createdAt         DateTime        @default(now())
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@unique([documentVersionId, chunkIndex])
  @@index([documentVersionId])
}

model RetrievalRun {
  id              String             @id @default(uuid()) @db.Uuid
  projectId       String             @db.Uuid
  userId          String             @db.Uuid
  query           String
  normalizedQuery String
  mode            RetrievalMode
  filters         Json               @default("{}")
  status          RetrievalRunStatus @default(COMPLETED)
  timingsMs       Json               @default("{}")
  resultCount     Int                @default(0)
  createdAt       DateTime           @default(now())
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  response        RagResponse?
  analysisRuns    AnalysisRun[]

  @@index([projectId, userId, createdAt])
  @@index([projectId, createdAt])
}

model RagResponse {
  id                   String           @id @default(uuid()) @db.Uuid
  retrievalRunId       String           @unique @db.Uuid
  answer               String
  insufficientEvidence Boolean          @default(false)
  createdAt            DateTime         @default(now())
  retrievalRun         RetrievalRun     @relation(fields: [retrievalRunId], references: [id], onDelete: Cascade)
  citations            RagCitation[]
  feedback             AnswerFeedback[]
}

model RagCitation {
  id            String      @id @default(uuid()) @db.Uuid
  ragResponseId String      @db.Uuid
  evidenceId    String
  documentId    String      @db.Uuid
  chunkId       String      @db.Uuid
  quote         String
  createdAt     DateTime    @default(now())
  ragResponse   RagResponse @relation(fields: [ragResponseId], references: [id], onDelete: Cascade)

  @@index([ragResponseId])
  @@index([documentId])
}

model AnswerFeedback {
  id            String      @id @default(uuid()) @db.Uuid
  ragResponseId String      @db.Uuid
  userId        String      @db.Uuid
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())
  ragResponse   RagResponse @relation(fields: [ragResponseId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ragResponseId, userId])
  @@index([userId, createdAt])
}

model IngestionJob {
  id                String             @id @default(uuid()) @db.Uuid
  documentVersionId String             @db.Uuid
  bullJobId         String?
  status            IngestionJobStatus @default(QUEUED)
  attempt           Int                @default(0)
  progress          Int                @default(0)
  currentStage      String?
  queuedAt          DateTime           @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  errorCode         String?
  errorMessage      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  documentVersion   DocumentVersion    @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@index([documentVersionId, status, createdAt])
  @@index([status, queuedAt])
}

model DecisionAnalysis {
  id                      String        @id @default(uuid()) @db.Uuid
  projectId               String        @db.Uuid
  createdById             String        @db.Uuid
  title                   String
  decisionQuestion        String
  objectives              Json          @default("[]")
  constraints             Json          @default("[]")
  assumptions             Json          @default("[]")
  timeHorizon             String?
  targetMarket            String?
  currency                String?
  knowledgeBaseIds        Json
  documentIds             Json          @default("[]")
  mode                    AnalysisMode
  evidenceMode            EvidenceMode  @default(INTERNAL_ONLY)
  externalResearchEnabled Boolean       @default(false)
  researchCountry         String?
  researchLanguages       Json          @default("[]")
  publishedAfter          DateTime?
  publishedBefore         DateTime?
  preferredDomains        Json          @default("[]")
  excludedDomains         Json          @default("[]")
  sourceTypes             Json          @default("[]")
  maximumExternalSources  Int?
  requestedSpecialists    Json          @default("[]")
  additionalContext       String?
  archivedAt              DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  project                 Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy               User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  runs                    AnalysisRun[]

  @@index([projectId, archivedAt, createdAt])
  @@index([createdById, createdAt])
}

model AnalysisRun {
  id                    String               @id @default(uuid()) @db.Uuid
  analysisId            String               @db.Uuid
  projectId             String               @db.Uuid
  userId                String               @db.Uuid
  billingOwnerUserId    String               @db.Uuid
  status                AnalysisStatus       @default(DRAFT)
  threadId              String               @unique
  graphVersion          String
  promptVersions        Json                 @default("{}")
  bullJobId             String?              @unique
  cancellationRequested Boolean              @default(false)
  currentStage          String?
  progress              Int                  @default(0)
  plan                  Json?
  initialRetrievalRunId String?              @db.Uuid
  tokenUsage            Json                 @default("{}")
  estimatedCost         Decimal?             @db.Decimal(12, 6)
  timingsMs             Json                 @default("{}")
  errorCode             String?
  errorMessage          String?
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  analysis              DecisionAnalysis     @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  project               Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  retrievalRun          RetrievalRun?        @relation(fields: [initialRetrievalRunId], references: [id], onDelete: SetNull)
  agentRuns             AgentRun[]
  report                AnalysisReport?
  checkpoints           AnalysisCheckpoint[]
  researchRun           ResearchRun?
  evidenceConflicts     EvidenceConflict[]
  experimentRuns        ExperimentRun[]
  reportSnapshot        ReportSnapshot?

  @@index([analysisId, createdAt])
  @@index([projectId, status, createdAt])
  @@index([userId, status, createdAt])
  @@index([billingOwnerUserId, status, createdAt])
}

model AgentRun {
  id            String          @id @default(uuid()) @db.Uuid
  analysisRunId String          @db.Uuid
  specialist    SpecialistType?
  nodeName      String
  status        AgentRunStatus  @default(PENDING)
  result        Json?
  tokenUsage    Json            @default("{}")
  timingsMs     Json            @default("{}")
  errorCode     String?
  errorMessage  String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  analysisRun   AnalysisRun     @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)

  @@unique([analysisRunId, nodeName])
  @@index([analysisRunId, status])
}

model AnalysisReport {
  id                String                     @id @default(uuid()) @db.Uuid
  analysisRunId     String                     @unique @db.Uuid
  report            Json
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  analysisRun       AnalysisRun                @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  citations         AnalysisCitation[]
  externalCitations ExternalAnalysisCitation[]
}

model AnalysisCitation {
  id               String         @id @default(uuid()) @db.Uuid
  analysisReportId String         @db.Uuid
  evidenceId       String
  documentId       String         @db.Uuid
  chunkId          String         @db.Uuid
  quote            String
  createdAt        DateTime       @default(now())
  analysisReport   AnalysisReport @relation(fields: [analysisReportId], references: [id], onDelete: Cascade)

  @@unique([analysisReportId, evidenceId, chunkId])
  @@index([documentId])
}

model AnalysisCheckpoint {
  id            String      @id @default(uuid()) @db.Uuid
  analysisRunId String      @db.Uuid
  graphVersion  String
  nodeName      String
  state         Json
  createdAt     DateTime    @default(now())
  analysisRun   AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)

  @@unique([analysisRunId, nodeName])
  @@index([createdAt])
}

model ResearchRun {
  id                       String             @id @default(uuid()) @db.Uuid
  analysisRunId            String             @unique @db.Uuid
  projectId                String             @db.Uuid
